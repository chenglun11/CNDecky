{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cndecky",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-30",
  "build": { "command": "python3 build.py", "watch_dir": ["../scripts", "../cndecky/launcher.py"] },
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": true },
  "ratelimits": [{ "name": "rate limit", "namespace_id": "1", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "PUBLIC_BASE_URL": "https://cndecky.lchnan.cn" },
  "routes": [{ "pattern": "cndecky.lchnan.cn", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
