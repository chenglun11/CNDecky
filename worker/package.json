{
  "name": "cndecky-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build.py",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var PUBLIC_BASE_URL:http://localhost:8787",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
